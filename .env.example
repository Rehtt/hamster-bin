PORT=8080
VERSION=v1.0.0

DB_DRIVER=sqlite
DB_DSN=
DB_PATH=/app/data/inventory.db
IMAGE_DIR=/app/data/images
LOG_LEVEL=info

SSL_CERT=
SSL_KEY=

ADMIN_USERNAME=
ADMIN_PASSWORD=
JWT_SECRET=
JWT_EXPIRE_HOURS=168

# 统一登录（可与管理员密码登录并存）；启用后须配置客户端、回调及 JWT_SECRET
OAUTH_ENABLED=false
OAUTH_ISSUER=https://oauth.home.rehtt.com
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# 管理员精确登记该地址，开发可用 http://127.0.0.1:5173/api/v1/auth/oauth/callback
OAUTH_REDIRECT_URL=
OAUTH_AUTH_METHOD=client_secret_basic

# 远程 MCP：留空关闭；外部客户端通过 Authorization: Bearer <token> 访问 /mcp
MCP_TOKEN=
# 可选：允许的完整 Origin，逗号分隔；默认仅同源或无 Origin
MCP_ALLOWED_ORIGINS=

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

TASK_WORKERS=2
TASK_TIMEOUT_SECONDS=120
